{
  "expo": {
    "name": "Arawa",
    "slug": "arawa",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "arawa",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.arawa.mobile" },
    "android": { "package": "com.arawa.mobile", "adaptiveIcon": { "backgroundColor": "#07090D" } },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Arawa to use your camera to create and share moments.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Arawa to select a photo for your local moment.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Arawa to access photos you choose.",
          "savePhotosPermission": "Allow Arawa to save captured moments to your photo library.",
          "granularPermissions": ["photo"],
          "preventAutomaticLimitedAccessAlert": true
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
